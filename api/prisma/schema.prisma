// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma" // Ajusta esta ruta si es necesario
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------- ENUMS -------------

enum RoleName {
  ADMIN
  TEACHER
  STUDENT
}

enum CourseInstanceStatus {
  Planned
  Active
  Finished
  Cancelled
}

enum DayOfWeek {
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
  Sunday
}

enum ProgramEnrollmentStatus {
  Enrolled
  Graduated
  Withdrawn
  Inactive
}

enum CourseEnrollmentStatus {
  Enrolled
  Dropped
  Completed
  Failed
}

enum ExtensionPublicationStatus {
  Draft
  Published
  Cancelled
  Completed
}

enum ExtensionEnrollmentStatus {
  Enrolled
  Cancelled
  Completed
}


// ------------- MODELS -------------

model Role {
  id        Int       @id @default(autoincrement())
  roleName  RoleName  @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  active    Boolean   @default(true)

  users     User[] // Back-relation to Users

  @@map("Role") // Maps to the 'Role' table
}


model User {
  id           Int    @id @default(autoincrement())
  roleId       Int    
  name         String 
  email        String @unique 
  password     String 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  active       Boolean  @default(true)

  role                Role?                  @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to Role

  // Back-relations
  passwordResetTokens PasswordResetToken[]
  passwordHistory     PasswordHistory[]
  personalInfo        PersonalInfo?       // One-to-one back-relation
  student             Student?              // One-to-one back-relation
  teacher             Teacher?              // One-to-one back-relation

  @@map("Users") // Maps to the 'Users' table
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique 
  expiresAt DateTime
  createdAt DateTime @default(now())
  active       Boolean  @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to User

  @@map("PasswordResetTokens")
}

model PasswordHistory {
  id           Int      @id @default(autoincrement())
  userId       Int
  passwordHash String   
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to User

  @@index([userId], map: "idx_PasswordHistory_userId")
  @@map("PasswordHistory")
}

model PersonalInfo {
  id                   Int       @id // This is both PK and FK referencing User.id
  identificationNumber String    @unique 
  birthdate            DateTime? @db.Date
  address              String?   
  phoneNumber          String?   

  user User @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade) // 1-to-1 relation with User

  @@map("PersonalInfo")
}

model Student {
  id Int @id // This is the PK and FK referencing User.id

  user User @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to User (1-to-1)

  // Back-relations
  parentsInfo                ParentsInfo[]
  enrollmentsPrograms        EnrollmentProgram[]
  enrollmentsCourses         EnrollmentCourse[]
  extensionCourseEnrollments ExtensionCourseEnrollment[]

  @@map("Students")
}

model ParentsInfo {
  id           Int    @id @default(autoincrement())
  studentId    Int?   // Made optional to align with potential SET NULL/RESTRICT, though SQL implies NOT NULL via FK. Adjust if needed.
  relationship String 
  name         String 
  phoneNumber  String 

  student Student? @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to Student

  @@map("ParentsInfo")
}

model ContractType {
  id                    Int       @id @default(autoincrement())
  typeName              String    @unique @db.VarChar(100)
  description           String?   
  allowsExtensionCourse Boolean   @default(true) @map("allowsExtensionCourse")
  affectsSalary         Boolean   @default(false) @map("affectsSalary")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  active                Boolean   @default(true) 

  teachers Teacher[] // Back-relation to Teachers

  @@map("ContractTypes")
}

model Teacher {
  id             Int      @id // This is the PK and FK referencing User.id
  contractTypeId Int?     // Optional based on potential RESTRICT/SET NULL on FK
  specialty      String   
  experience     String   
  baseSalary     Decimal  @map("baseSalary") @db.Decimal(10, 2)

  user         User          @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to User (1-to-1)
  contractType ContractType? @relation(fields: [contractTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to ContractTypes

  // Back-relations
  courseInstances          CourseInstance[]          @relation("TeacherCourseInstances")
  extensionCourseInstances ExtensionCourseInstance[] @relation("TeacherExtensionCourseInstances")

  @@map("Teachers")
}

model AcademicProgram {
  id          Int     @id @default(autoincrement())
  programName String  @unique  @map("programName")
  programCode String  @unique @db.VarChar(50) @map("programCode")
  description String  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true) 

  // Back-relations
  courses             Course[]
  extensionCourses    ExtensionCourse[]
  enrollmentsPrograms EnrollmentProgram[]

  @@map("AcademicPrograms")
}

model Course {
  id          Int     @id @default(autoincrement())
  programId   Int
  courseName  String   @map("courseName")
  courseCode  String  @unique @db.VarChar(50) @map("courseCode") // Unique constraint on the column itself
  description String 
  credits     Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  active      Boolean  @default(true) 

  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to AcademicPrograms

  // Back-relation
  courseInstances CourseInstance[]

  @@unique([programId, courseCode], map: "uq_course_program") // Composite unique key
  @@map("Courses")
}

model ExtensionCourse {
  id            Int       @id @default(autoincrement())
  programId     Int      // Required - a course must belong to a program
  courseName    String     @map("courseName")
  courseCode    String    @unique @db.VarChar(50) @map("courseCode")
  description   String    
  durationHours Int       @map("durationHours")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  active        Boolean   @default(true) 

  program AcademicProgram @relation(fields: [programId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to AcademicPrograms

  // Back-relation
  extensionCourseInstances ExtensionCourseInstance[]

  @@map("ExtensionCourses")
}

model CourseInstance {
  id          Int                  @id @default(autoincrement())
  courseId    Int
  teacherId   Int                  // Required - a course instance must have a teacher
  semester    String               @db.VarChar(20) @map("semester")
  groupCode   String               @db.VarChar(20) @map("groupCode")
  startDate   DateTime             @db.Date @map("startDate")
  endDate     DateTime             @db.Date @map("endDate")
  minStudents Int                  @default(1) @map("minStudents")
  maxStudents Int                  @map("maxStudents")
  status      CourseInstanceStatus @default(Planned)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  active      Boolean              @default(true) 

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to Courses
  teacher Teacher @relation("TeacherCourseInstances", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to Teachers

  // Back-relations
  schedules   ScheduleCourseInstance[]
  enrollments EnrollmentCourse[]

  @@unique([courseId, semester, groupCode], map: "uq_course_instance") 
  @@map("CourseInstances")
}

model ScheduleCourseInstance {
  id               Int            @id @default(autoincrement())
  courseInstanceId Int
  day              DayOfWeek
  startTime        Int            @map("startTime")
  endTime          Int            @map("endTime")
  classroom        String         @db.VarChar(50)

  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to CourseInstances

  @@map("SchedulesCoursesInstances")
}

model EnrollmentProgram {
  id                Int                     @id @default(autoincrement())
  studentId         Int
  academicProgramId Int
  enrollmentDate    DateTime                @default(now()) @map("enrollmentDate")
  status            ProgramEnrollmentStatus @default(Enrolled)

  student         Student         @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to Students
  academicProgram AcademicProgram @relation(fields: [academicProgramId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to AcademicPrograms

  @@unique([studentId, academicProgramId], map: "uq_student_program") // Composite unique key
  @@map("EnrollmentsPrograms")
}

model EnrollmentCourse {
  id               Int                    @id @default(autoincrement())
  studentId        Int
  courseInstanceId Int
  enrollmentDate   DateTime               @default(now()) @map("enrollmentDate")
  status           CourseEnrollmentStatus @default(Enrolled)

  student        Student        @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to Students
  courseInstance CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to CourseInstances

  grade Grade? // Back-relation (1-to-1)

  @@unique([studentId, courseInstanceId], map: "uq_student_course_instance") // Composite unique key
  @@map("EnrollmentsCourses")
}

model Grade {
  id                 Int      @id @default(autoincrement())
  enrollmentCourseId Int      @unique @map("enrollmentCourseId")
  term1_grade        Decimal? @db.Decimal(5, 2)
  term2_grade        Decimal? @db.Decimal(5, 2)
  term3_grade        Decimal? @db.Decimal(5, 2)
  final              Decimal? @db.Decimal(5, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enrollmentCourse EnrollmentCourse @relation(fields: [enrollmentCourseId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to EnrollmentsCourses

  @@map("Grades")
}

model ExtensionCourseInstance {
  id                  Int                        @id @default(autoincrement())
  extensionCourseId   Int                        @map("extensionCourseId")
  teacherId           Int                        // Required - an extension course instance must have a teacher
  groupCode          String                     @db.VarChar(20) @map("groupCode") // Required
  startDate           DateTime                   @db.Date @map("startDate")
  endDate             DateTime                   @db.Date @map("endDate")
  maxStudents         Int                       @map("maxStudents")
  publicationStatus   ExtensionPublicationStatus @default(Draft) @map("publicationStatus")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  active              Boolean                    @default(true) 

  extensionCourse ExtensionCourse @relation(fields: [extensionCourseId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to ExtensionCourses
  teacher         Teacher         @relation("TeacherExtensionCourseInstances", fields: [teacherId], references: [id], onDelete: Restrict, onUpdate: Cascade) // Relation to Teachers

  // Back-relations
  schedules   ScheduleExtensionCourseInstance[]
  enrollments ExtensionCourseEnrollment[]

  @@map("ExtensionCourseInstances")
}

model ScheduleExtensionCourseInstance {
  id                        Int                     @id @default(autoincrement())
  extensionCourseInstanceId Int                     @map("extensionCourseInstanceId")
  day                       DayOfWeek
  startTime                 Int                     @map("startTime")
  endTime                   Int                     @map("endTime")
  classroom                 String                  @db.VarChar(50)

  extensionCourseInstance ExtensionCourseInstance @relation(fields: [extensionCourseInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to ExtensionCourseInstances

  @@map("SchedulesExtensionCourseInstances")
}

model ExtensionCourseEnrollment {
  id                        Int                       @id @default(autoincrement())
  studentId                 Int
  extensionCourseInstanceId Int                       @map("extensionCourseInstanceId")
  enrollmentDate            DateTime                  @default(now()) @map("enrollmentDate")
  status                    ExtensionEnrollmentStatus @default(Enrolled)

  student                 Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to Students
  extensionCourseInstance ExtensionCourseInstance @relation(fields: [extensionCourseInstanceId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to ExtensionCourseInstances

  grade ExtensionCourseGrade? // Back-relation (1-to-1)

  @@unique([studentId, extensionCourseInstanceId], map: "uq_student_ext_course_instance") // Composite unique key
  @@map("ExtensionCourseEnrollments")
}

model ExtensionCourseGrade {
  id                          Int      @id @default(autoincrement())
  extensionCourseEnrollmentId Int      @unique @map("extensionCourseEnrollmentId")
  term1_grade        Decimal? @db.Decimal(5, 2)
  term2_grade        Decimal? @db.Decimal(5, 2)
  term3_grade        Decimal? @db.Decimal(5, 2)
  final              Decimal? @db.Decimal(5, 2)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  extensionCourseEnrollment ExtensionCourseEnrollment @relation(fields: [extensionCourseEnrollmentId], references: [id], onDelete: Cascade, onUpdate: Cascade) // Relation to ExtensionCourseEnrollments

  @@map("ExtensionCourseGrades")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String   
  answer    String   
  category  String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  active    Boolean  @default(true) 

  @@map("Faqs")
}
