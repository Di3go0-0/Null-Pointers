# Environment variables for Null-Pointers application

# Database Configuration
DB_NAME=escuela
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=database
DB_PORT=5432

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=24h

# API Configuration
API_PORT=3000
NODE_ENV=production

# Frontend Configuration
FRONTEND_URL=http://localhost:4200

# Email Configuration (if using Resend or similar)
RESEND_API_KEY=re_dummy_key_for_testing
EMAIL_FROM=noreply@your-domain.com